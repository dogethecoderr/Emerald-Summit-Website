# WHERE TO FIND THESE IN SUPABASE:
# 1. Open https://supabase.com/dashboard
# 2. Select the app's project (dgrskmykbkvphnaasfzl). The website shares it.
# 3. Gear icon → "Project Settings" → "API"
# 4. "Project URL" → VITE_SUPABASE_URL
# 5. "Project API keys" → publishable key → VITE_SUPABASE_PUBLISHABLE_KEY
#    (Use the publishable key only — never put the service_role key in the app.)

VITE_SUPABASE_URL=https://dgrskmykbkvphnaasfzl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-shared-project-key

# Test accounts need no variable: they're switched on in src/lib/devLogin.ts.
